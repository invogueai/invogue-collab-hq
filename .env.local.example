# ── Supabase → Settings → API ──
# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

# Server-side only — NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
# Used by src/lib/auth.js and the public /api/acknowledge endpoint.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY_HERE

# ── Resend (email) ──
# Required for /api/send-email (confirmation + delivery emails).
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# Optional — sender shown on outgoing email. Defaults to "Invogue Collabs <sm@invogue.shop>".
EMAIL_FROM=Invogue Collabs <sm@invogue.shop>
